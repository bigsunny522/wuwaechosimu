# お問い合わせフォーム（Web3Forms）用のアクセスキー
# https://web3forms.com で無料登録して取得してください（メールアドレスを入力するだけ）
# このキーは公開しても問題ない Public Access Key です（クライアント側で使用します）
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Adsterra バナー広告（https://adsterra.com でサイト登録・審査後、Banner 広告ユニットを発行してください）
# 発行された広告コードは次の形をしています:
#   <script>
#     atOptions = { key: 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx', format: 'iframe', height: 250, width: 300, params: {} };
#   </script>
#   <script src="//example.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/invoke.js"></script>
# 上記の atOptions.key を NEXT_PUBLIC_ADSTERRA_BANNER_KEY に、
# 2つ目の <script src="..."> をそのまま NEXT_PUBLIC_ADSTERRA_BANNER_SCRIPT_SRC に入力してください。
# 未設定の間は広告枠自体が非表示になり、既存の表示には影響しません。
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_SCRIPT_SRC=
NEXT_PUBLIC_ADSTERRA_BANNER_WIDTH=300
NEXT_PUBLIC_ADSTERRA_BANNER_HEIGHT=250

# Adsterra Native Banner 広告（Banner とは別に Native Banner 広告ユニットを発行してください）
# 発行された広告コードは次の形をしています:
#   <script async="async" data-cfasync="false" src="//example.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/invoke.js"></script>
#   <div id="container-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"></div>
# 上記の <script src="..."> をそのまま NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT_SRC に、
# <div id="container-xxxx..."> の xxxx... 部分（container- の後ろ）を NEXT_PUBLIC_ADSTERRA_NATIVE_KEY に入力してください。
# 未設定の間は広告枠自体が非表示になり、既存の表示には影響しません。
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT_SRC=
